# Disable directory listing (no "Index of /ossi")
Options -Indexes

# Default index page (order matters)
DirectoryIndex index.html index.htm index.php

# Prevent viewing .htaccess and .git files
<Files ".htaccess">
    Require all denied
</Files>

# Optional: Allow common static files to be served
<IfModule mod_mime.c>
    AddType text/html .html .htm
    AddType text/css .css
    AddType application/javascript .js
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType image/gif .gif
</IfModule>

# Optional: Enable basic caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType image/jpg "access plus 1 week"
    ExpiresByType image/jpeg "access plus 1 week"
    ExpiresByType image/png "access plus 1 week"
    ExpiresByType image/gif "access plus 1 week"
</IfModule>

# Optional: Security headers (if mod_headers is enabled)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
</IfModule>